# AnyDevice backend configuration (local dev).
# Copy this file to `.env`, fill in your own values, and run:
#   cp .env.example .env            (POSIX)  /  Copy-Item .env.example .env  (PowerShell)

# Storage engine: "disk" (SQLite + local folders, no setup) or "supabase".
ANYDEVICE_BACKEND=disk

# --- Supabase mode (ANYDEVICE_BACKEND=supabase) -----------------------------
# Create a free project at https://supabase.com, then:
#   SUPABASE_URL  -> Project Settings -> API   -> Project URL
#   SUPABASE_SERVICE_ROLE_KEY -> Project Settings -> API -> service_role key (SECRET)
#   SUPABASE_DATABASE_URL -> Project Settings -> Database -> Connection string
#     Use the IPv4 pooler (aws-0-<region>.pooler.supabase.com) — db.<ref>.supabase.co
#     is IPv6-only and unreachable from many networks. Keep ?sslmode=require.
#   SUPABASE_BUCKET -> a PRIVATE storage bucket (default: shares; create it first).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_BUCKET=shares

# --- Optional overrides -----------------------------------------------------
# ANYDEVICE_CLEANUP=1           # auto-purge expired shares (dev convenience)
# ANYDEVICE_TRUST_PROXY=1       # only when behind a trusted reverse proxy (Render etc.)
# ANYDEVICE_ADMIN_KEY=          # operator-only /api/admin/stats secret (empty = endpoint disabled)
# ANYDEVICE_FILE_MAX=52428800   # per-file cap in bytes
# ANYDEVICE_TOTAL_MAX=104857600 # total content cap per code in bytes